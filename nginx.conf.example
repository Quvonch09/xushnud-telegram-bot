# ==============================================================================
# Nginx Configuration for Telegram Mini App & Bot Backend
# Replace 'app.example.uz' with your actual domain name.
# ==============================================================================

# HTTP -> HTTPS Redirect
server {
    listen 80;
    listen [::]:80;
    server_name app.example.uz;

    # Let's Encrypt verification
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# HTTPS Server
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name app.example.uz;

    # SSL Certificates (Managed by Certbot)
    ssl_certificate /etc/letsencrypt/live/app.example.uz/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/app.example.uz/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    # Security Headers for Telegram WebApp
    add_header X-Frame-Options "ALLOW-FROM https://web.telegram.org";
    add_header Content-Security-Policy "frame-ancestors 'self' https://web.telegram.org https://*.telegram.org;";
    add_header X-Content-Type-Options nosniff;
    add_header X-XSS-Protection "1; mode=block";

    # Static Frontend for Telegram Mini App
    root /var/www/telegram-mini-app/webapp;
    index index.html;

    # Serve static assets directly with caching
    location /css/ {
        alias /var/www/telegram-mini-app/webapp/css/;
        expires 7d;
        access_log off;
    }

    location /js/ {
        alias /var/www/telegram-mini-app/webapp/js/;
        expires 7d;
        access_log off;
    }

    # Telegram Mini App Frontend (SPA routing)
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Proxy REST API requests to FastAPI
    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Proxy Telegram Webhook
    location /webhook {
        proxy_pass http://127.0.0.1:8000/webhook;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
